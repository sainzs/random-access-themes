# Random Access Theme colors for delta (https://github.com/dandavison/delta)
# Add this to your ~/.gitconfig include path, e.g.:
#   [include]
#       path = /path/to/integrations/gitconfig-delta
[delta]
    syntax-theme = ansi
    dark = true
    line-numbers = true
    plus-style = syntax "#0b3318"
    plus-emph-style = syntax "#1a5c2e"
    minus-style = syntax "#33150b"
    minus-emph-style = syntax "#5c261a"
    line-numbers-zero-style = "#6f8d86"
    line-numbers-plus-style = "#4ade80"
    line-numbers-minus-style = "#26c994"
    line-numbers-left-format = "{nm:>4}┊"
    line-numbers-right-format = "{np:>4}┊"
    file-style = bold "#00ffb2"
    hunk-header-style = "#9cb7af"
