#!/bin/sh
# One-shot gate runner for the terminal theme. Exit 1 if any gate fails.
# Gates: contrast/ΔE, Ghostty config (+ single load, shader compile), kitty parse,
# iTerm2 profile JSON, Warp yaml, starship, zsh syntax, pi theme contract.
set -u
HERE="$(cd "$(dirname "$0")/.." && pwd)"
G=/Applications/Ghostty.app/Contents/MacOS/ghostty
K=/Applications/kitty.app/Contents/MacOS/kitty
fail=0
ok()  { printf 'ok    %s\n' "$1"; }
bad() { printf 'FAIL  %s\n' "$1"; fail=1; }

"$HERE/bin/check-contrast" >/tmp/theme-check.contrast 2>&1 && ok "check-contrast (WCAG ×3 + ΔE)" || { bad "check-contrast"; grep -E 'BAD|FAIL' /tmp/theme-check.contrast; }

"$G" +validate-config >/dev/null 2>&1 && ok "ghostty +validate-config" || bad "ghostty +validate-config"
n=$("$G" +show-config 2>/dev/null | grep -c '^custom-shader = ')
[ "$n" = "$(grep -c '^custom-shader = ' "$HOME/.config/ghostty/config")" ] && ok "ghostty loads config once ($n shaders)" || bad "ghostty double-load? show-config has $n custom-shader lines"
[ -e "$HOME/Library/Application Support/com.mitchellh.ghostty/config" ] && bad "App Support ghostty config exists (double load)" || ok "no App Support ghostty config"
if command -v glslangValidator >/dev/null; then
  for sh in "$HOME"/.config/ghostty/shaders/*.glsl; do
    { cat /tmp/ghostty-shader-stub.glsl 2>/dev/null || cat "$HERE/ghostty-shader-stub.glsl"; cat "$sh"; printf '\nvoid main(){ mainImage(_fragColor, gl_FragCoord.xy); }\n'; } > /tmp/theme-check.frag
    glslangValidator -S frag /tmp/theme-check.frag >/dev/null 2>&1 && ok "shader $(basename "$sh") compiles" || bad "shader $(basename "$sh")"
  done
fi

"$K" +runpy 'import sys; from kitty.config import load_config; b=[]; load_config("'"$HOME"'/.config/kitty/kitty.conf", accumulate_bad_lines=b); sys.exit(1 if b else 0)' >/dev/null 2>&1 && ok "kitty config parses (0 bad lines)" || bad "kitty config has bad lines"

jq -e '.Profiles[0].Name' "$HOME/Library/Application Support/iTerm2/DynamicProfiles/matte-black-hc.json" >/dev/null 2>&1 && ok "iTerm2 dynamic profile JSON" || bad "iTerm2 dynamic profile JSON"
yq -e '.terminal_colors.normal.blue' "$HOME/.warp/themes/matte-black-hc.yaml" >/dev/null 2>&1 && ok "warp theme yaml" || bad "warp theme yaml"
/opt/homebrew/bin/python3 -c 'import tomllib,pathlib; tomllib.loads(pathlib.Path.home().joinpath(".warp/settings.toml").read_text())' 2>/dev/null && ok "warp settings.toml" || bad "warp settings.toml"
starship print-config >/dev/null 2>&1 && ok "starship.toml" || bad "starship.toml"
zsh -n "$HOME/.zshrc" && zsh -n "$HOME/.config/shell/env.sh" && zsh -n "$HOME/.config/shell/palette.sh" && ok "zsh syntax (.zshrc, env.sh, palette.sh)" || bad "zsh syntax"
( cd "$HOME/.pi/agent/themes" && python3 validate_themes.py --strict >/dev/null 2>&1 ) && ok "pi themes --strict (surface rule)" || bad "pi themes --strict"

[ $fail = 0 ] && echo "PASS" || { echo "FAIL"; exit 1; }
