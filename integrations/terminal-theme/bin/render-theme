#!/usr/bin/env python3
"""Render theme.toml into every terminal's native theme format.

Writes (all files carry a GENERATED header; edit theme.toml, not them):
  ~/.config/ghostty/themes/<name>                     Ghostty theme
  ~/.config/kitty/<slug>.conf                         kitty colours (include'd)
  ~/Library/Application Support/iTerm2/DynamicProfiles/<slug>.json
  ~/.warp/themes/<slug>.yaml                          Warp theme
  ~/.config/shell/palette.sh                          TERMINAL_* exports
  ~/.config/terminal-theme/palette.json               for other tooling

--dry-run prints the paths and content it would write.
"""
import json, pathlib, sys, tomllib
sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent)); import palette_lib

ROOT = pathlib.Path(__file__).resolve().parent.parent
HOME = pathlib.Path.home()
T = palette_lib.load()
DRY = "--dry-run" in sys.argv
NAME, SLUG = T["meta"]["name"], T["meta"]["slug"]
HDR = f"GENERATED by ~/.config/terminal-theme/bin/render-theme from theme.toml — edit theme.toml, not this file."

ORDER = ["black", "red", "green", "yellow", "blue", "magenta", "cyan", "white",
         "bright_black", "bright_red", "bright_green", "bright_yellow", "bright_blue",
         "bright_magenta", "bright_cyan", "bright_white"]

def palette_for(term):
    acc = T["terminals"][term]
    subs = {"@accent": acc["accent"], "@accent_bright": acc["accent_bright"]}
    return [subs.get(T["palette"][k], T["palette"][k]) for k in ORDER], acc

import shutil, time
STAMP = time.strftime("%Y%m%d-%H%M%S")
BACKUP = ROOT / "backups" / STAMP          # gitignored; one dir per render
ROLLBACK = []

def write(path, content):
    """Write a target, backing up whatever it replaces and recording the undo."""
    path = pathlib.Path(path).expanduser()
    if DRY:
        print(f"\n### {path}\n{content}")
        return
    if path.exists() and path.read_text() == content:
        print(f"same  {path}"); return
    if path.exists():
        BACKUP.mkdir(parents=True, exist_ok=True)
        dst = BACKUP / path.name
        shutil.copy2(path, dst)
        ROLLBACK.append(f'cp -p "$B/{path.name}" "{str(path).replace(str(HOME), "$HOME")}"')
    else:
        ROLLBACK.append(f'rm -f "{str(path).replace(str(HOME), "$HOME")}"')
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(content)
    print(f"wrote {path}")

B = T["base"]

# ── Ghostty ────────────────────────────────────────────────────────────────
pal, acc = palette_for("ghostty")
lines = [f"# {NAME} — Ghostty", f"# {HDR}", "",
         f"background = {B['background'].lstrip('#')}",
         f"foreground = {B['foreground'].lstrip('#')}",
         f"cursor-color = {acc['accent'].lstrip('#')}",
         f"cursor-text = {B['background'].lstrip('#')}",
         f"selection-background = {B['selection_background'].lstrip('#')}",
         f"selection-foreground = {B['selection_foreground'].lstrip('#')}",
         f"split-divider-color = {B['split_divider'].lstrip('#')}",
         f"unfocused-split-fill = {B['background'].lstrip('#')}", ""]
lines += [f"palette = {i}={c}" for i, c in enumerate(pal)]
write(HOME / ".config/ghostty/themes" / NAME, "\n".join(lines) + "\n")

# ── kitty ──────────────────────────────────────────────────────────────────
pal, acc = palette_for("kitty")
k = [f"# {NAME} — kitty", f"# {HDR}", "",
     f"foreground {B['foreground']}", f"background {B['background']}",
     f"cursor {acc['accent']}", f"cursor_text_color {B['background']}",
     f"cursor_trail_color {acc['accent']}",
     f"selection_foreground {B['selection_foreground']}",
     f"selection_background {B['selection_background']}",
     f"url_color {acc['accent_bright']}",
     f"visual_bell_color {acc['accent_bright']}",
     f"active_border_color {acc['accent']}",
     f"inactive_border_color {B['split_divider']}",
     f"bell_border_color {acc['accent_bright']}",
     f"macos_titlebar_color {B['background']}",
     f"tab_bar_background {B['surface']}",
     f"active_tab_foreground {B['background']}",
     f"active_tab_background {acc['accent']}",
     f"inactive_tab_foreground {T['palette']['bright_black']}",
     f"inactive_tab_background {B['surface_raised']}",
     f"window_title_bar_active_foreground {acc['accent']}",
     f"window_title_bar_active_background {B['surface_raised']}",
     f"window_title_bar_inactive_foreground {T['palette']['bright_black']}",
     f"window_title_bar_inactive_background {B['surface']}",
     f"mark1_foreground {B['background']}", f"mark1_background {acc['accent']}",
     f"mark2_foreground {B['background']}", f"mark2_background {T['palette']['green']}",
     f"mark3_foreground {B['background']}", f"mark3_background {T['palette']['cyan']}", ""]
k += [f"color{i} {c}" for i, c in enumerate(pal)]
write(HOME / ".config/kitty" / f"{SLUG}.conf", "\n".join(k) + "\n")

# ── iTerm2 dynamic profile ─────────────────────────────────────────────────
pal, acc = palette_for("iterm2")
def icolor(h):
    h = h.lstrip("#")
    r, g, b = (int(h[i:i+2], 16) / 255 for i in (0, 2, 4))
    return {"Color Space": "sRGB", "Alpha Component": 1,
            "Red Component": round(r, 6), "Green Component": round(g, 6), "Blue Component": round(b, 6)}
glass = T["glass"]
prof = {
    "Name": NAME,
    "Guid": "7E1C0A1E-4D2B-4B3E-9C2A-0000B1AC0001",
    "Dynamic Profile Parent Name": "Default",
    "Use Separate Colors for Light and Dark Mode": False,
    "Normal Font": f"{T['font']['family'].replace(' ', '')}-Regular {T['font']['size']}",
    "Non Ascii Font": f"{T['font']['symbols'].replace(' ', '')}-Regular {T['font']['size'] - 1}",
    "Use Non-ASCII Font": True,
    "ASCII Ligatures": True,
    "Use Bold Font": True, "Use Bright Bold": True, "Use Italic Font": True,
    "Thin Strokes": 0,
    "Minimum Contrast": 0.15,
    "Transparency": round(1 - glass["opacity"], 3),
    "Blur": True, "Blur Radius": glass["blur"],
    "Only The Default BG Color Uses Transparency": True,
    "Cursor Type": 2, "Blinking Cursor": False, "Cursor Boost": 0.15,   # block, like the other terminals
    "Use Cursor Guide": False, "Cursor Shadow": True,
    "Vertical Spacing": 1.08, "Horizontal Spacing": 1.0,
    "Background Color": icolor(B["background"]),
    "Foreground Color": icolor(B["foreground"]),
    "Bold Color": icolor(T["palette"]["bright_white"]),
    "Cursor Color": icolor(acc["accent"]),
    "Cursor Text Color": icolor(B["background"]),
    "Cursor Guide Color": icolor(B["surface_raised"]),
    "Selection Color": icolor(B["selection_background"]),
    "Selected Text Color": icolor(B["selection_foreground"]),
    "Link Color": icolor(acc["accent_bright"]),
    "Badge Color": icolor(acc["accent"]),
    "Use Tab Color": False,          # a tab colour tints the whole titlebar in iTerm2
    "Show Mark Indicators": False,   # no blue gutter triangles (matches Ghostty no-cursor)
}
for i, c in enumerate(pal):
    prof[f"Ansi {i} Color"] = icolor(c)
write(HOME / "Library/Application Support/iTerm2/DynamicProfiles" / f"{SLUG}.json",
      json.dumps({"Profiles": [prof]}, indent=2) + "\n")

# ── Warp ───────────────────────────────────────────────────────────────────
pal, acc = palette_for("warp")
names = ["black", "red", "green", "yellow", "blue", "magenta", "cyan", "white"]
def block(cols): return "\n".join(f"    {n}: \"{c}\"" for n, c in zip(names, cols))
warp = f"""# {NAME} — Warp
# {HDR}
name: "{NAME}"
scheme: "{NAME}"
details: darker

background: "{B['background']}"
foreground: "{B['foreground']}"
accent: "{acc['accent']}"
cursor: "{acc['accent']}"
cursor_text: "{B['background']}"
selection_background: "{B['selection_background']}"
selection_foreground: "{B['selection_foreground']}"

# Warp UI surfaces (tabs, blocks, chips, panels) — base16 ramp from the skeleton.
base00: "{B['background']}"
base01: "{B['surface_raised']}"
base02: "{B['split_divider']}"
base03: "{T['palette']['bright_black']}"
base04: "{T['palette']['cyan']}"
base05: "{B['foreground']}"
base06: "{T['palette']['bright_cyan']}"
base07: "{T['palette']['bright_white']}"
base08: "{T['palette']['red']}"
base09: "{T['palette']['yellow']}"
base0A: "{T['palette']['yellow']}"
base0B: "{T['palette']['green']}"
base0C: "{T['palette']['cyan']}"
base0D: "{acc['accent']}"
base0E: "{T['palette']['magenta']}"
base0F: "{B['surface']}"

terminal_colors:
  normal:
{block(pal[:8])}
  bright:
{block(pal[8:])}
"""
write(HOME / ".warp/themes" / f"{SLUG}.yaml", warp)

# ── Shell palette (TERMINAL_* roles) ───────────────────────────────────────
P = T["palette"]
case = "\n".join(
    f"  {pat}) export TERMINAL_ACCENT=\"{T['terminals'][t]['accent']}\" TERMINAL_ACCENT_BRIGHT=\"{T['terminals'][t]['accent_bright']}\" ;;"
    for t, pat in (("warp", "WarpTerminal"), ("ghostty", "Ghostty|ghostty|com.mitchellh.ghostty"),
                   ("iterm2", "iTerm.app"), ("kitty", "kitty")))
sh = f"""# {NAME} — shell palette
# {HDR}
# Neutral roles are identical in every terminal. The accent rides ANSI slot 4/12
# (`blue`) inside each terminal's theme; the hex below is only for consumers
# that cannot use ANSI names.
export TERMINAL_THEME="{SLUG}"
export TERMINAL_BG="{B['background']}"
export TERMINAL_TEXT="{B['foreground']}"
export TERMINAL_MUTED="{P['bright_black']}"
export TERMINAL_SUCCESS="{P['green']}"
export TERMINAL_WARN="{P['yellow']}"
export TERMINAL_ERROR="{P['red']}"
export TERMINAL_ACCENT_ALT="{P['magenta']}"
export TERMINAL_SELECTION="{B['selection_background']}"
case "${{TERM_PROGRAM:-}}" in
{case}
  *) export TERMINAL_ACCENT="{T['terminals']['ghostty']['accent']}" TERMINAL_ACCENT_BRIGHT="{T['terminals']['ghostty']['accent_bright']}" ;;
esac
"""
write(HOME / ".config/shell/palette.sh", sh)

# ── machine-readable dump ──────────────────────────────────────────────────
dump = {"name": NAME, "slug": SLUG, "base": B, "glass": glass, "font": T["font"],
        "palette": {k: T["palette"][k] for k in ORDER}, "terminals": T["terminals"]}
write(ROOT / "palette.json", json.dumps(dump, indent=2) + "\n")

# ── rollback for this render ───────────────────────────────────────────────
if not DRY and ROLLBACK:
    BACKUP.mkdir(parents=True, exist_ok=True)
    (BACKUP / "rollback.sh").write_text("#!/bin/sh\n# Undo the render of " + STAMP + "\nset -e\nB=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\n" + "\n".join(ROLLBACK) + "\necho restored\n")
    (BACKUP / "rollback.sh").chmod(0o755)
    latest = ROOT / "backups" / "latest"
    if latest.is_symlink() or latest.exists(): latest.unlink()
    latest.symlink_to(BACKUP)
    print(f"backup + rollback: {BACKUP}")
