#!/opt/homebrew/bin/python3
"""Deterministic gate: every text role in theme.toml must clear WCAG contrast
against the background — both solid and glass-composited (opacity over a
mid-grey wallpaper, the worst realistic case). Exit 1 on any failure."""
import sys, tomllib, pathlib
sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent)); import palette_lib

ROOT = pathlib.Path(__file__).resolve().parent.parent
T = palette_lib.load()

def rgb(h): h = h.lstrip("#"); return tuple(int(h[i:i+2], 16) / 255 for i in (0, 2, 4))
def lin(c): return c / 12.92 if c <= 0.04045 else ((c + 0.055) / 1.055) ** 2.4
def lum(h): r, g, b = (lin(c) for c in rgb(h)); return 0.2126 * r + 0.7152 * g + 0.0722 * b
def ratio(fg, bg): a, b = lum(fg), lum(bg); return (max(a, b) + 0.05) / (min(a, b) + 0.05)
def blend(fg, bg, a):
    f, b = rgb(fg), rgb(bg)
    return "#" + "".join(f"{round((fc * a + bc * (1 - a)) * 255):02x}" for fc, bc in zip(f, b))

bg = T["base"]["background"]
# Glass composites: opacity over a mid-grey and over a WHITE wallpaper (the
# actual worst case for a dark surface).
glass_bg = blend(bg, "#808080", T["glass"]["opacity"])
glass_white_bg = blend(bg, "#ffffff", T["glass"]["opacity"])
MIN_TEXT, MIN_FG, MIN_SURFACE = 4.5, 7.0, 1.3   # black slot is a surface colour, not text
fails = 0

def check(label, color, floor, against):
    global fails
    r = ratio(color, against)
    ok = r >= floor
    fails += not ok
    print(f"{'ok ' if ok else 'BAD'} {label:<34} {color}  {r:5.2f}:1  (min {floor})")

for bgname, b in (("solid", bg), ("glass/grey", glass_bg), ("glass/white", glass_white_bg)):
    print(f"\n== against {bgname} background {b} ==")
    check("foreground", T["base"]["foreground"], MIN_FG, b)
    check("selection_foreground on sel bg", T["base"]["selection_foreground"], MIN_TEXT, T["base"]["selection_background"])
    for slot, color in T["palette"].items():
        if color.startswith("@"):
            continue
        if slot == "black":   # ANSI 0 is used as a background by TUIs; only needs to be visibly distinct
            check("palette.black (surface)", color, MIN_SURFACE, b); continue
        check(f"palette.{slot}", color, MIN_TEXT, b)
    for term, spec in T["terminals"].items():
        check(f"{term}.accent", spec["accent"], MIN_TEXT, b)
        check(f"{term}.accent_bright", spec["accent_bright"], MIN_TEXT, b)

# ── Perceptual separation: an accent must not masquerade as a semantic slot ──
# CIELAB ΔE76. ~2 = just noticeable; 25 = unmistakably different colours.
def lab(h):
    r, g, b = (lin(c) * 100 for c in rgb(h))
    x = (0.4124 * r + 0.3576 * g + 0.1805 * b) / 95.047
    y = (0.2126 * r + 0.7152 * g + 0.0722 * b) / 100.0
    z = (0.0193 * r + 0.1192 * g + 0.9505 * b) / 108.883
    f = lambda v: v ** (1 / 3) if v > 0.008856 else 7.787 * v + 16 / 116
    fx, fy, fz = f(x), f(y), f(z)
    return 116 * fy - 16, 500 * (fx - fy), 200 * (fy - fz)
def dE(a, b): return sum((p - q) ** 2 for p, q in zip(lab(a), lab(b))) ** 0.5
MIN_DE = 25
print("\n== perceptual separation ΔE76 (min", MIN_DE, ") ==")
sem = {k: T["palette"][k] for k in ("red", "green", "yellow", "magenta", "cyan", "white")}
brt = {k: T["palette"]["bright_" + k] for k in ("red", "green", "yellow", "magenta", "cyan", "white")}
for term, spec in T["terminals"].items():
    for slot, col in sem.items():
        d = dE(spec["accent"], col); ok = d >= MIN_DE; fails += not ok
        print(f"{'ok ' if ok else 'BAD'} {term + '.accent':<16} vs {slot:<8} ΔE {d:5.1f}")
    for slot, col in brt.items():
        d = dE(spec["accent_bright"], col); ok = d >= MIN_DE; fails += not ok
        print(f"{'ok ' if ok else 'BAD'} {term + '.accent_bright':<23} vs bright_{slot:<8} ΔE {d:5.1f}")
for a, b in (("cyan", "white"), ("red", "magenta"), ("green", "yellow"), ("yellow", "white")):
    d = dE(T["palette"][a], T["palette"][b]); ok = d >= MIN_DE; fails += not ok
    print(f"{'ok ' if ok else 'BAD'} palette.{a:<8} vs {b:<8} ΔE {d:5.1f}")

print(f"\n{'PASS' if not fails else f'FAIL ({fails} role(s) below floor)'}")
sys.exit(1 if fails else 0)
