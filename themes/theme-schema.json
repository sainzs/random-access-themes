{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Random Access Theme \u2014 agent theme (pi + Prime Agent)",
  "description": "Union schema for this repo's agent themes. The 55 tokens Prime Agent requires are mandatory; scrollbarThumb and thinkingMax are pi-only and optional. One file set therefore validates for both runtimes: pi ignores the four Prime-only tokens at runtime, and Prime requires them.",
  "type": "object",
  "required": [
    "name",
    "colors"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON schema reference"
    },
    "name": {
      "type": "string",
      "description": "Theme name"
    },
    "vars": {
      "type": "object",
      "description": "Reusable color variables",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string",
            "description": "Hex color (#RRGGBB), variable reference, or empty string for terminal default"
          },
          {
            "type": "integer",
            "minimum": 0,
            "maximum": 255,
            "description": "256-color palette index (0-255)"
          }
        ]
      }
    },
    "colors": {
      "type": "object",
      "description": "Theme color definitions (all required)",
      "required": [
        "accent",
        "bashMode",
        "border",
        "borderAccent",
        "borderMuted",
        "customMessageBg",
        "customMessageLabel",
        "customMessageText",
        "dim",
        "error",
        "mdCode",
        "mdCodeBlock",
        "mdCodeBlockBorder",
        "mdHeading",
        "mdHr",
        "mdLink",
        "mdLinkUrl",
        "mdListBullet",
        "mdQuote",
        "mdQuoteBorder",
        "muted",
        "selectedBg",
        "success",
        "syntaxComment",
        "syntaxFunction",
        "syntaxKeyword",
        "syntaxNumber",
        "syntaxOperator",
        "syntaxPunctuation",
        "syntaxString",
        "syntaxType",
        "syntaxVariable",
        "text",
        "thinkingHigh",
        "thinkingLow",
        "thinkingMedium",
        "thinkingMinimal",
        "thinkingOff",
        "thinkingText",
        "thinkingXhigh",
        "toolDiffAdded",
        "toolDiffAddedBg",
        "toolDiffContext",
        "toolDiffRemoved",
        "toolDiffRemovedBg",
        "toolDiffText",
        "toolErrorBg",
        "toolOutput",
        "toolPanelBg",
        "toolPendingBg",
        "toolSuccessBg",
        "toolTitle",
        "userMessageBg",
        "userMessageText",
        "warning"
      ],
      "properties": {
        "accent": {
          "$ref": "#/$defs/colorValue",
          "description": "Primary accent color (logo, selected items, cursor)"
        },
        "bashMode": {
          "$ref": "#/$defs/colorValue",
          "description": "Editor border color in bash mode"
        },
        "border": {
          "$ref": "#/$defs/colorValue",
          "description": "Normal borders"
        },
        "borderAccent": {
          "$ref": "#/$defs/colorValue",
          "description": "Highlighted borders"
        },
        "borderMuted": {
          "$ref": "#/$defs/colorValue",
          "description": "Subtle borders"
        },
        "customMessageBg": {
          "$ref": "#/$defs/colorValue",
          "description": "Custom message background (hook-injected messages)"
        },
        "customMessageLabel": {
          "$ref": "#/$defs/colorValue",
          "description": "Custom message type label color"
        },
        "customMessageText": {
          "$ref": "#/$defs/colorValue",
          "description": "Custom message text color"
        },
        "dim": {
          "$ref": "#/$defs/colorValue",
          "description": "Very dimmed text (more subtle than muted)"
        },
        "error": {
          "$ref": "#/$defs/colorValue",
          "description": "Error states"
        },
        "mdCode": {
          "$ref": "#/$defs/colorValue",
          "description": "Markdown inline code"
        },
        "mdCodeBlock": {
          "$ref": "#/$defs/colorValue",
          "description": "Markdown code block content"
        },
        "mdCodeBlockBorder": {
          "$ref": "#/$defs/colorValue",
          "description": "Markdown code block fences"
        },
        "mdHeading": {
          "$ref": "#/$defs/colorValue",
          "description": "Markdown heading text"
        },
        "mdHr": {
          "$ref": "#/$defs/colorValue",
          "description": "Markdown horizontal rule"
        },
        "mdLink": {
          "$ref": "#/$defs/colorValue",
          "description": "Markdown link text"
        },
        "mdLinkUrl": {
          "$ref": "#/$defs/colorValue",
          "description": "Markdown link URL"
        },
        "mdListBullet": {
          "$ref": "#/$defs/colorValue",
          "description": "Markdown list bullets/numbers"
        },
        "mdQuote": {
          "$ref": "#/$defs/colorValue",
          "description": "Markdown blockquote text"
        },
        "mdQuoteBorder": {
          "$ref": "#/$defs/colorValue",
          "description": "Markdown blockquote border"
        },
        "muted": {
          "$ref": "#/$defs/colorValue",
          "description": "Secondary/dimmed text"
        },
        "scrollbarThumb": {
          "$ref": "#/$defs/colorValue",
          "description": "Fullscreen scrollbar thumb background (falls back to selectedBg when omitted)"
        },
        "selectedBg": {
          "$ref": "#/$defs/colorValue",
          "description": "Selected item background"
        },
        "success": {
          "$ref": "#/$defs/colorValue",
          "description": "Success states"
        },
        "syntaxComment": {
          "$ref": "#/$defs/colorValue",
          "description": "Syntax highlighting: comments"
        },
        "syntaxFunction": {
          "$ref": "#/$defs/colorValue",
          "description": "Syntax highlighting: function names"
        },
        "syntaxKeyword": {
          "$ref": "#/$defs/colorValue",
          "description": "Syntax highlighting: keywords"
        },
        "syntaxNumber": {
          "$ref": "#/$defs/colorValue",
          "description": "Syntax highlighting: number literals"
        },
        "syntaxOperator": {
          "$ref": "#/$defs/colorValue",
          "description": "Syntax highlighting: operators"
        },
        "syntaxPunctuation": {
          "$ref": "#/$defs/colorValue",
          "description": "Syntax highlighting: punctuation"
        },
        "syntaxString": {
          "$ref": "#/$defs/colorValue",
          "description": "Syntax highlighting: string literals"
        },
        "syntaxType": {
          "$ref": "#/$defs/colorValue",
          "description": "Syntax highlighting: type names"
        },
        "syntaxVariable": {
          "$ref": "#/$defs/colorValue",
          "description": "Syntax highlighting: variable names"
        },
        "text": {
          "$ref": "#/$defs/colorValue",
          "description": "Default text color (usually empty string)"
        },
        "thinkingHigh": {
          "$ref": "#/$defs/colorValue",
          "description": "Thinking level border: high"
        },
        "thinkingLow": {
          "$ref": "#/$defs/colorValue",
          "description": "Thinking level border: low"
        },
        "thinkingMax": {
          "$ref": "#/$defs/colorValue",
          "description": "Thinking level border: max (falls back to thinkingXhigh when omitted)"
        },
        "thinkingMedium": {
          "$ref": "#/$defs/colorValue",
          "description": "Thinking level border: medium"
        },
        "thinkingMinimal": {
          "$ref": "#/$defs/colorValue",
          "description": "Thinking level border: minimal"
        },
        "thinkingOff": {
          "$ref": "#/$defs/colorValue",
          "description": "Thinking level border: off"
        },
        "thinkingText": {
          "$ref": "#/$defs/colorValue",
          "description": "Thinking block text color"
        },
        "thinkingXhigh": {
          "$ref": "#/$defs/colorValue",
          "description": "Thinking level border: xhigh (OpenAI codex-max only)"
        },
        "toolDiffAdded": {
          "$ref": "#/$defs/colorValue",
          "description": "Added lines in tool diffs"
        },
        "toolDiffAddedBg": {
          "$ref": "#/$defs/colorValue",
          "description": "Diff added-line background block"
        },
        "toolDiffContext": {
          "$ref": "#/$defs/colorValue",
          "description": "Context lines in tool diffs"
        },
        "toolDiffRemoved": {
          "$ref": "#/$defs/colorValue",
          "description": "Removed lines in tool diffs"
        },
        "toolDiffRemovedBg": {
          "$ref": "#/$defs/colorValue",
          "description": "Diff removed-line background block"
        },
        "toolDiffText": {
          "$ref": "#/$defs/colorValue",
          "description": "Diff line content on colored add/remove blocks"
        },
        "toolErrorBg": {
          "$ref": "#/$defs/colorValue",
          "description": "Tool execution box (error state)"
        },
        "toolOutput": {
          "$ref": "#/$defs/colorValue",
          "description": "Tool execution box output text color"
        },
        "toolPanelBg": {
          "$ref": "#/$defs/colorValue",
          "description": "Tool panel background (ipython cells and tool executions)"
        },
        "toolPendingBg": {
          "$ref": "#/$defs/colorValue",
          "description": "Tool execution box (pending state)"
        },
        "toolSuccessBg": {
          "$ref": "#/$defs/colorValue",
          "description": "Tool execution box (success state)"
        },
        "toolTitle": {
          "$ref": "#/$defs/colorValue",
          "description": "Tool execution box title color"
        },
        "userMessageBg": {
          "$ref": "#/$defs/colorValue",
          "description": "User message background"
        },
        "userMessageText": {
          "$ref": "#/$defs/colorValue",
          "description": "User message text color"
        },
        "warning": {
          "$ref": "#/$defs/colorValue",
          "description": "Warning states"
        }
      },
      "additionalProperties": false
    },
    "export": {
      "type": "object",
      "description": "Optional colors for HTML export (defaults derived from userMessageBg if not specified)",
      "properties": {
        "pageBg": {
          "$ref": "#/$defs/colorValue",
          "description": "Page background color"
        },
        "cardBg": {
          "$ref": "#/$defs/colorValue",
          "description": "Card/container background color"
        },
        "infoBg": {
          "$ref": "#/$defs/colorValue",
          "description": "Info sections background (system prompt, notices)"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "colorValue": {
      "oneOf": [
        {
          "type": "string",
          "description": "Hex color (#RRGGBB), variable reference, or empty string for terminal default"
        },
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "description": "256-color palette index (0-255)"
        }
      ]
    }
  }
}
