{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "bg": "#0a120c",
    "bg1": "#2f3c32",
    "bg2": "#14231a",
    "surface": "#0a120c",
    "overlay": "#2f3c32",
    "text": "#6fe392",
    "subtle": "#55a06b",
    "dim": "#506d58",
    "mint": "#a8ffc2",
    "cyan": "#a8ffc2",
    "green": "#6fe392",
    "teal": "#55a06b",
    "jade": "#6fe392",
    "aqua": "#dcffe7",
    "emerald": "#ff7a5c",
    "lime": "#e8d25f",
    "diffAddBg": "#162b1c",
    "diffRemBg": "#271e16"
  },
  "theme": {
    "primary": {
      "dark": "mint",
      "light": "mint"
    },
    "secondary": {
      "dark": "cyan",
      "light": "cyan"
    },
    "accent": {
      "dark": "teal",
      "light": "teal"
    },
    "error": {
      "dark": "emerald",
      "light": "emerald"
    },
    "warning": {
      "dark": "aqua",
      "light": "aqua"
    },
    "success": {
      "dark": "green",
      "light": "green"
    },
    "info": {
      "dark": "jade",
      "light": "jade"
    },
    "text": {
      "dark": "text",
      "light": "text"
    },
    "textMuted": {
      "dark": "subtle",
      "light": "subtle"
    },
    "background": {
      "dark": "bg",
      "light": "bg"
    },
    "backgroundPanel": {
      "dark": "bg1",
      "light": "bg1"
    },
    "backgroundElement": {
      "dark": "surface",
      "light": "surface"
    },
    "border": {
      "dark": "bg2",
      "light": "bg2"
    },
    "borderActive": {
      "dark": "mint",
      "light": "mint"
    },
    "borderSubtle": {
      "dark": "surface",
      "light": "surface"
    },
    "diffAdded": {
      "dark": "mint",
      "light": "mint"
    },
    "diffRemoved": {
      "dark": "emerald",
      "light": "emerald"
    },
    "diffContext": {
      "dark": "subtle",
      "light": "subtle"
    },
    "diffHunkHeader": {
      "dark": "cyan",
      "light": "cyan"
    },
    "diffHighlightAdded": {
      "dark": "mint",
      "light": "mint"
    },
    "diffHighlightRemoved": {
      "dark": "emerald",
      "light": "emerald"
    },
    "diffAddedBg": {
      "dark": "diffAddBg",
      "light": "diffAddBg"
    },
    "diffRemovedBg": {
      "dark": "diffRemBg",
      "light": "diffRemBg"
    },
    "diffContextBg": {
      "dark": "bg1",
      "light": "bg1"
    },
    "diffLineNumber": {
      "dark": "dim",
      "light": "dim"
    },
    "diffAddedLineNumberBg": {
      "dark": "diffAddBg",
      "light": "diffAddBg"
    },
    "diffRemovedLineNumberBg": {
      "dark": "diffRemBg",
      "light": "diffRemBg"
    },
    "markdownText": {
      "dark": "text",
      "light": "text"
    },
    "markdownHeading": {
      "dark": "mint",
      "light": "mint"
    },
    "markdownLink": {
      "dark": "cyan",
      "light": "cyan"
    },
    "markdownLinkText": {
      "dark": "jade",
      "light": "jade"
    },
    "markdownCode": {
      "dark": "jade",
      "light": "jade"
    },
    "markdownBlockQuote": {
      "dark": "subtle",
      "light": "subtle"
    },
    "markdownEmph": {
      "dark": "subtle",
      "light": "subtle"
    },
    "markdownStrong": {
      "dark": "text",
      "light": "text"
    },
    "markdownHorizontalRule": {
      "dark": "overlay",
      "light": "overlay"
    },
    "markdownListItem": {
      "dark": "teal",
      "light": "teal"
    },
    "markdownListEnumeration": {
      "dark": "dim",
      "light": "dim"
    },
    "markdownImage": {
      "dark": "cyan",
      "light": "cyan"
    },
    "markdownImageText": {
      "dark": "jade",
      "light": "jade"
    },
    "markdownCodeBlock": {
      "dark": "text",
      "light": "text"
    },
    "syntaxComment": {
      "dark": "dim",
      "light": "dim"
    },
    "syntaxKeyword": {
      "dark": "jade",
      "light": "jade"
    },
    "syntaxFunction": {
      "dark": "green",
      "light": "green"
    },
    "syntaxVariable": {
      "dark": "text",
      "light": "text"
    },
    "syntaxString": {
      "dark": "lime",
      "light": "lime"
    },
    "syntaxNumber": {
      "dark": "aqua",
      "light": "aqua"
    },
    "syntaxType": {
      "dark": "mint",
      "light": "mint"
    },
    "syntaxOperator": {
      "dark": "teal",
      "light": "teal"
    },
    "syntaxPunctuation": {
      "dark": "subtle",
      "light": "subtle"
    }
  }
}
