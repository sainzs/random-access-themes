{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "bg": "#000000",
    "bg1": "#0f0e0d",
    "bg2": "#1a1715",
    "surface": "#141210",
    "overlay": "#2a2623",
    "text": "#f2efec",
    "subtle": "#b1a8a2",
    "dim": "#817771",
    "mint": "#7b93ff",
    "cyan": "#6b7ef5",
    "green": "#9baaf2",
    "teal": "#5c70d8",
    "jade": "#b4bef0",
    "aqua": "#c8d2ff",
    "emerald": "#4d5ec8",
    "lime": "#dce2ff",
    "diffAddBg": "#0d1033",
    "diffRemBg": "#160f2a"
  },
  "theme": {
    "primary": {
      "dark": "mint",
      "light": "mint"
    },
    "secondary": {
      "dark": "cyan",
      "light": "cyan"
    },
    "accent": {
      "dark": "teal",
      "light": "teal"
    },
    "error": {
      "dark": "emerald",
      "light": "emerald"
    },
    "warning": {
      "dark": "aqua",
      "light": "aqua"
    },
    "success": {
      "dark": "green",
      "light": "green"
    },
    "info": {
      "dark": "jade",
      "light": "jade"
    },
    "text": {
      "dark": "text",
      "light": "text"
    },
    "textMuted": {
      "dark": "subtle",
      "light": "subtle"
    },
    "background": {
      "dark": "bg",
      "light": "bg"
    },
    "backgroundPanel": {
      "dark": "bg1",
      "light": "bg1"
    },
    "backgroundElement": {
      "dark": "surface",
      "light": "surface"
    },
    "border": {
      "dark": "bg2",
      "light": "bg2"
    },
    "borderActive": {
      "dark": "mint",
      "light": "mint"
    },
    "borderSubtle": {
      "dark": "surface",
      "light": "surface"
    },
    "diffAdded": {
      "dark": "mint",
      "light": "mint"
    },
    "diffRemoved": {
      "dark": "emerald",
      "light": "emerald"
    },
    "diffContext": {
      "dark": "subtle",
      "light": "subtle"
    },
    "diffHunkHeader": {
      "dark": "cyan",
      "light": "cyan"
    },
    "diffHighlightAdded": {
      "dark": "mint",
      "light": "mint"
    },
    "diffHighlightRemoved": {
      "dark": "emerald",
      "light": "emerald"
    },
    "diffAddedBg": {
      "dark": "diffAddBg",
      "light": "diffAddBg"
    },
    "diffRemovedBg": {
      "dark": "diffRemBg",
      "light": "diffRemBg"
    },
    "diffContextBg": {
      "dark": "bg1",
      "light": "bg1"
    },
    "diffLineNumber": {
      "dark": "dim",
      "light": "dim"
    },
    "diffAddedLineNumberBg": {
      "dark": "diffAddBg",
      "light": "diffAddBg"
    },
    "diffRemovedLineNumberBg": {
      "dark": "diffRemBg",
      "light": "diffRemBg"
    },
    "markdownText": {
      "dark": "text",
      "light": "text"
    },
    "markdownHeading": {
      "dark": "mint",
      "light": "mint"
    },
    "markdownLink": {
      "dark": "cyan",
      "light": "cyan"
    },
    "markdownLinkText": {
      "dark": "jade",
      "light": "jade"
    },
    "markdownCode": {
      "dark": "jade",
      "light": "jade"
    },
    "markdownBlockQuote": {
      "dark": "subtle",
      "light": "subtle"
    },
    "markdownEmph": {
      "dark": "subtle",
      "light": "subtle"
    },
    "markdownStrong": {
      "dark": "text",
      "light": "text"
    },
    "markdownHorizontalRule": {
      "dark": "overlay",
      "light": "overlay"
    },
    "markdownListItem": {
      "dark": "teal",
      "light": "teal"
    },
    "markdownListEnumeration": {
      "dark": "dim",
      "light": "dim"
    },
    "markdownImage": {
      "dark": "cyan",
      "light": "cyan"
    },
    "markdownImageText": {
      "dark": "jade",
      "light": "jade"
    },
    "markdownCodeBlock": {
      "dark": "text",
      "light": "text"
    },
    "syntaxComment": {
      "dark": "dim",
      "light": "dim"
    },
    "syntaxKeyword": {
      "dark": "jade",
      "light": "jade"
    },
    "syntaxFunction": {
      "dark": "green",
      "light": "green"
    },
    "syntaxVariable": {
      "dark": "text",
      "light": "text"
    },
    "syntaxString": {
      "dark": "lime",
      "light": "lime"
    },
    "syntaxNumber": {
      "dark": "aqua",
      "light": "aqua"
    },
    "syntaxType": {
      "dark": "mint",
      "light": "mint"
    },
    "syntaxOperator": {
      "dark": "teal",
      "light": "teal"
    },
    "syntaxPunctuation": {
      "dark": "subtle",
      "light": "subtle"
    }
  }
}
