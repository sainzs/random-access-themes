    "list.hoverBackground":               "#141210",
    "list.hoverForeground":               "#f2efec",
    "list.highlightForeground":           "#2ccfc0",
    "list.focusHighlightForeground":      "#2ccfc0",

    "scrollbar.shadow":                   "#00000000",
    "scrollbarSlider.background":         "#2a262344",
    "scrollbarSlider.hoverBackground":    "#2a2623aa",
    "scrollbarSlider.activeBackground":   "#2a2623cc",

    "widget.shadow":                      "#00000088",
    "focusBorder":                        "#1a9e91",

    "button.background":                  "#1a9e91",
    "button.foreground":                  "#000000",
    "button.hoverBackground":             "#2ccfc0",

    "badge.background":                   "#2ccfc0",
    "badge.foreground":                   "#000000",

    "progressBar.background":             "#2ccfc0",

    "gitDecoration.addedResourceForeground":      "#2ccfc0",
    "gitDecoration.modifiedResourceForeground":   "#a8ddd9",
    "gitDecoration.deletedResourceForeground":    "#0f7a6e",
    "gitDecoration.untrackedResourceForeground":  "#7dd4cc",
    "gitDecoration.ignoredResourceForeground":    "#817771",
    "gitDecoration.conflictingResourceForeground":"#ddf4f2",

    "diffEditor.insertedTextBackground":  "#2ccfc011",
    "diffEditor.removedTextBackground":   "#0f7a6e11"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#817771", "fontStyle": "italic" } },

    { "scope": ["keyword", "keyword.control", "keyword.operator.word", "storage.type", "storage.modifier"],
      "settings": { "foreground": "#a8ddd9" } },

    { "scope": "keyword.operator",
      "settings": { "foreground": "#1a9e91" } },

    { "scope": ["entity.name.function", "support.function", "meta.function-call.generic"],
      "settings": { "foreground": "#22b8ab" } },

    { "scope": ["entity.name.type", "entity.name.class", "entity.name.interface", "support.type", "support.class"],
      "settings": { "foreground": "#2ccfc0", "fontStyle": "bold" } },

    { "scope": ["variable.parameter", "meta.parameter"],
      "settings": { "foreground": "#c5ebe8" } },

    { "scope": "variable.other",
      "settings": { "foreground": "#f2efec" } },

    { "scope": ["string", "string.quoted"],
      "settings": { "foreground": "#ddf4f2" } },

    { "scope": "string.regexp",
      "settings": { "foreground": "#7dd4cc" } },

    { "scope": "constant.numeric",
      "settings": { "foreground": "#c5ebe8" } },

    { "scope": ["constant.language", "constant.character"],
      "settings": { "foreground": "#a8ddd9" } },

    { "scope": "punctuation",
      "settings": { "foreground": "#b1a8a2" } },

    { "scope": ["entity.name.tag", "support.class.component"],
      "settings": { "foreground": "#2ccfc0" } },

    { "scope": "entity.other.attribute-name",
      "settings": { "foreground": "#a8ddd9" } },

    { "scope": "support.type.property-name, meta.property-name",
      "settings": { "foreground": "#22b8ab" } },

    { "scope": "invalid",
      "settings": { "foreground": "#f2efec", "background": "#0f7a6e" } },

    // Markdown / notetaking
    { "scope": ["markup.heading", "entity.name.section"],
      "settings": { "foreground": "#2ccfc0", "fontStyle": "bold" } },

    { "scope": "markup.bold",
      "settings": { "foreground": "#f2efec", "fontStyle": "bold" } },

    { "scope": "markup.italic",
      "settings": { "foreground": "#b1a8a2", "fontStyle": "italic" } },

    { "scope": "markup.underline.link",
      "settings": { "foreground": "#22b8ab", "fontStyle": "underline" } },

    { "scope": ["markup.raw.inline", "markup.raw.block"],
      "settings": { "foreground": "#a8ddd9" } },

    { "scope": "markup.quote",
      "settings": { "foreground": "#b1a8a2", "fontStyle": "italic" } },

    { "scope": "markup.list punctuation.definition",
      "settings": { "foreground": "#1a9e91" } },

    { "scope": ["markup.inserted", "diff.inserted"],
      "settings": { "foreground": "#2ccfc0" } },

    { "scope": ["markup.deleted", "diff.deleted"],
      "settings": { "foreground": "#0f7a6e" } },

    { "scope": ["markup.changed", "diff.changed"],
      "settings": { "foreground": "#a8ddd9" } }
  ]
}
